---
import { getCollection } from 'astro:content';
import PageShell from '../../layouts/PageShell.astro';
import { profile } from '../../data/profile';

// Drafts are visible in dev only, so a work in progress never ships.
const showDrafts = import.meta.env.DEV;
const posts = (await getCollection('posts'))
  .filter((p) => showDrafts || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date): string => d.toISOString().slice(0, 10);
---

<PageShell
  title={`Writing · ${profile.name}`}
  description="Notes on directing AI, shipping software, and building tools worth keeping."
>
  <div class="index shell">
    <header class="index-head">
      <h1>Writing</h1>
      <p>
        Notes on directing AI, shipping software, and building tools worth
        keeping.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a class="post" href={`/blog/${p.id}`}>
                <time datetime={fmtDate(p.data.date)}>{fmtDate(p.data.date)}</time>
                <div>
                  <h2>
                    {p.data.title}
                    {p.data.draft && <span class="draft">draft</span>}
                  </h2>
                  <p>{p.data.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    <p class="back"><a href="/">&#8592; Back to the start</a></p>
  </div>
</PageShell>

<style>
  .index {
    padding: var(--s14) var(--pad-x) var(--s20);
    min-height: 62vh;
  }

  .index-head {
    padding-bottom: var(--s6);
    border-bottom: 1px solid var(--hair);
  }

  .index-head h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--t1);
  }

  .index-head p {
    margin-top: var(--s3);
    max-width: 58ch;
    font-size: var(--fs-lede);
    color: var(--t2);
  }

  .posts > li {
    border-bottom: 1px solid var(--hair);
  }

  .post {
    display: grid;
    grid-template-columns: var(--spine) minmax(0, 1fr);
    column-gap: var(--gutter);
    padding: var(--s6) 0;
    align-items: baseline;
  }

  .post time {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
    color: var(--t3);
  }

  .post h2 {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-size: var(--fs-lede);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--t1);
    line-height: var(--lh-heading);
    transition: color var(--t-fast) ease;
  }

  .draft {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    font-weight: 400;
    padding: 0.125rem var(--s2);
    border: 1px solid var(--hair-2);
    border-radius: var(--r-chip);
    color: var(--t3);
  }

  .post p {
    font-size: var(--fs-sm);
    color: var(--t2);
    margin-top: 0.375rem;
    max-width: 62ch;
  }

  .empty {
    padding: var(--s8) 0;
    color: var(--t3);
  }

  .back {
    margin-top: var(--s12);
  }

  .back a {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t3);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--t-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .post:hover h2 {
      color: #fff;
    }

    .back a:hover {
      color: var(--t1);
    }
  }

  @media (max-width: 800px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s2);
    }
  }
</style>
