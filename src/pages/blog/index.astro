---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ChromeBar from '../../components/ChromeBar.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// Drafts render in dev, are excluded from the production build.
const showDrafts = import.meta.env.DEV;
const posts = (await getCollection('posts'))
  .filter((p) => showDrafts || !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date): string => d.toISOString().slice(0, 10);
---

<Layout
  title="blog · Laurence Rebadulla"
  description="Notes on shipping LLM features, retrieval pipelines, and production engineering."
>
  <a class="skip-link" href="#main">skip to content</a>
  <div class="terminal">
    <header>
      <ChromeBar />
      <SiteNav />
    </header>

    <main id="main" class="blog pad-x">
      <p class="cmd"><span class="prompt">$</span> ls blog/ --recent</p>
      <h1 class="blog-h1">Writing</h1>

      {
        posts.length === 0 ? (
          <p class="empty"># no posts yet</p>
        ) : (
          <ol class="posts">
            {posts.map((post) => (
              <li class="post-row">
                <a class="post-link" href={`/blog/${post.id}`}>
                  <span class="post-date">{fmtDate(post.data.date)}</span>
                  <span class="post-detail">
                    <span class="post-title">
                      {post.data.title}
                      {post.data.draft && <span class="draft"> [draft]</span>}
                    </span>
                    <span class="post-summary">{post.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </main>

    <SiteFooter />
  </div>
</Layout>

<style>
  .blog {
    padding-top: 48px;
    padding-bottom: 72px;
    min-height: 62vh;
  }

  .cmd {
    margin-bottom: 10px;
  }

  .blog-h1 {
    margin: 0 0 26px;
    font: 600 26px var(--font);
    letter-spacing: -0.02em;
  }

  .empty {
    margin: 0;
    font: 400 13px var(--font);
    color: var(--text-muted);
  }

  .posts {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-row {
    border-top: 1px solid var(--hairline);
  }

  .post-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .post-link {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 32px;
    padding: 22px 0;
    transition: opacity var(--hover);
  }

  .post-date {
    font: 400 12.5px var(--font);
    color: var(--text-muted);
  }

  .post-title {
    font: 600 15px var(--font);
    color: var(--text);
    transition: color var(--hover);
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  .draft {
    color: var(--text-muted);
    font-weight: 400;
  }

  .post-summary {
    display: block;
    margin-top: 6px;
    font: 400 13px/1.7 var(--font);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .post-link {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
