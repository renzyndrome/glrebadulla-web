---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ChromeBar from '../../components/ChromeBar.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/prose.css';

export const prerender = true;

export const getStaticPaths = (async () => {
  const showDrafts = import.meta.env.DEV;
  const posts = (await getCollection('posts')).filter(
    (p) => showDrafts || !p.data.draft
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date): string => d.toISOString().slice(0, 10);
---

<Layout
  title={`${post.data.title} · Laurence Rebadulla`}
  description={post.data.summary}
>
  <a class="skip-link" href="#main">skip to content</a>
  <div class="terminal">
    <header>
      <ChromeBar />
      <SiteNav />
    </header>

    <main id="main" class="post pad-x">
      <p class="cmd"><span class="prompt">$</span> cat blog/{post.id}.md</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{fmtDate(post.data.date)}</p>

      <article class="prose">
        <Content />
      </article>

      <p class="back"><a href="/blog">&larr; ls blog/</a></p>
    </main>

    <SiteFooter />
  </div>
</Layout>

<style>
  .post {
    padding-top: 48px;
    padding-bottom: 72px;
    min-height: 62vh;
  }

  .cmd {
    margin-bottom: 14px;
  }

  .post-title {
    margin: 0 0 8px;
    max-width: 760px;
    font: 600 30px/1.3 var(--font);
    letter-spacing: -0.02em;
  }

  .post-meta {
    margin: 0 0 32px;
    font: 400 12.5px var(--font);
    color: var(--text-muted);
  }

  .back {
    margin: 40px 0 0;
    font: 400 13px var(--font);
  }

  .back a {
    color: var(--text-muted);
    transition: color var(--hover);
  }

  .back a:hover {
    color: var(--accent);
  }

  /* Markdoc content styling is shared via src/styles/prose.css */
</style>
