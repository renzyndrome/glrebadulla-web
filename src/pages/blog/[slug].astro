---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageShell from '../../layouts/PageShell.astro';
import { profile } from '../../data/profile';
import '../../styles/prose.css';

export const prerender = true;

export const getStaticPaths = (async () => {
  const showDrafts = import.meta.env.DEV;
  const posts = (await getCollection('posts')).filter(
    (p) => showDrafts || !p.data.draft
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date): string => d.toISOString().slice(0, 10);
---

<PageShell
  title={`${post.data.title} · ${profile.name}`}
  description={post.data.summary}
>
  <article class="post shell">
    <p class="eyebrow">
      <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>
      {post.data.draft && <span class="draft">draft</span>}
    </p>

    <h1>{post.data.title}</h1>
    {post.data.summary && <p class="lead">{post.data.summary}</p>}

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/blog">&#8592; All writing</a></p>
  </article>
</PageShell>

<style>
  .post {
    padding: var(--s14) var(--pad-x) var(--s20);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-family: var(--mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
    color: var(--t3);
  }

  .draft {
    padding: 0.125rem var(--s2);
    border: 1px solid var(--hair-2);
    border-radius: var(--r-chip);
    color: var(--t2);
  }

  h1 {
    margin-top: var(--s3);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--t1);
    max-width: 26ch;
    text-wrap: balance;
  }

  .lead {
    margin-top: var(--s4);
    max-width: 62ch;
    font-size: var(--fs-lede);
    line-height: 1.62;
    color: var(--t2);
  }

  .prose {
    margin-top: var(--s10);
  }

  .back {
    margin-top: var(--s12);
    padding-top: var(--s5);
    border-top: 1px solid var(--hair);
  }

  .back a {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t3);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--t-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .back a:hover {
      color: var(--t1);
    }
  }
</style>
