---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageShell from '../../layouts/PageShell.astro';
import { profile } from '../../data/profile';
import '../../styles/prose.css';

export const prerender = true;

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const name = project.data.name ?? project.id;
const { description, chips, image } = project.data;
const { Content } = await render(project);
---

<PageShell title={`${name} · ${profile.name}`} description={description}>
  <article class="detail shell">
    <p class="eyebrow">Project</p>
    <h1>{name}</h1>
    <p class="lead">{description}</p>

    <ul class="tags">
      {chips.map((c) => <li class:list={[{ 'is-ai': c.ai }]}>{c.label}</li>)}
    </ul>

    {
      image ? (
        <img class="shot" src={image} alt={`Screenshot of ${name}`} loading="lazy" decoding="async" />
      ) : (
        <p class="nda">
          Built for an employer under NDA, so there is no screenshot here. What
          follows is a description of the work and the reasoning behind it.
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/#work">&#8592; All work</a></p>
  </article>
</PageShell>

<style>
  .detail {
    padding: var(--s14) var(--pad-x) var(--s20);
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.01em;
    color: var(--t3);
  }

  h1 {
    margin-top: var(--s3);
    font-family: var(--mono);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    color: var(--t1);
  }

  .lead {
    margin-top: var(--s4);
    max-width: 62ch;
    font-size: var(--fs-lede);
    line-height: 1.62;
    color: var(--t2);
  }

  .tags {
    margin-top: var(--s6);
  }

  .nda {
    margin-top: var(--s8);
    padding: var(--s4) var(--s5);
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    background: var(--n850);
    font-size: var(--fs-sm);
    color: var(--t3);
    max-width: 62ch;
  }

  .shot {
    margin-top: var(--s8);
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
  }

  .prose {
    margin-top: var(--s10);
  }

  .back {
    margin-top: var(--s12);
    padding-top: var(--s5);
    border-top: 1px solid var(--hair);
  }

  .back a {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t3);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--t-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .back a:hover {
      color: var(--t1);
    }
  }
</style>
