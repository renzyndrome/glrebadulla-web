---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ChromeBar from '../../components/ChromeBar.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/prose.css';

export const prerender = true;

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const name = project.data.name ?? project.id;
const { description, chips } = project.data;
const { Content } = await render(project);
---

<Layout title={`${name} · Laurence Rebadulla`} description={description}>
  <a class="skip-link" href="#main">skip to content</a>
  <div class="terminal">
    <header>
      <ChromeBar />
      <SiteNav />
    </header>

    <main id="main" class="detail pad-x">
      <p class="cmd">
        <span class="prompt">$</span> cat projects/{project.id}.md
      </p>
      <h1 class="detail-title">{name}</h1>
      <p class="detail-lead">{description}</p>

      <div class="detail-chips">
        {
          chips.map((c) => (
            <span class:list={['chip', c.ai ? 'chip--ai' : 'chip--neutral']}>
              {c.label}
            </span>
          ))
        }
      </div>

      <article class="prose">
        <Content />
      </article>

      <p class="back"><a href="/#projects">&larr; ls projects/</a></p>
    </main>

    <SiteFooter />
  </div>
</Layout>

<style>
  .detail {
    padding-top: 48px;
    padding-bottom: 72px;
    min-height: 62vh;
  }

  .cmd {
    margin-bottom: 14px;
  }

  .detail-title {
    margin: 0 0 12px;
    font: 600 30px/1.3 var(--font);
    letter-spacing: -0.02em;
  }

  .detail-lead {
    margin: 0 0 18px;
    max-width: 720px;
    font: 400 14.5px/1.75 var(--font);
    color: var(--text-secondary);
  }

  .detail-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font: 400 11px var(--font);
    padding: 4px 10px;
    border-radius: var(--r-chip);
  }

  .chip--ai {
    background: var(--accent-tint);
    color: var(--accent-soft);
  }

  .chip--neutral {
    background: var(--hairline-chip);
    color: var(--text-secondary);
  }

  .back {
    margin: 40px 0 0;
    font: 400 13px var(--font);
  }

  .back a {
    color: var(--text-muted);
    transition: color var(--hover);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
