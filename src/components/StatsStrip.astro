---
// Four hairline-divided cells. The value sits below the caption in source order
// (a <dl> reads key then value) but renders above it via column-reverse, so the
// number leads visually while the markup stays semantic.
import { stats } from '../data/stats';
---

<div class="shell">
  <dl class="stats" aria-label="Highlights">
    {
      stats.map((s) => (
        <div>
          <dt class="stat-k">{s.caption}</dt>
          <dd class:list={['stat-v', { 'stat-v--mark': s.mark }]}>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hair);
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s2);
    padding: var(--s7) var(--s7) var(--s7) 0;
    border-left: 1px solid var(--hair);
  }

  .stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stats > div:not(:first-child) {
    padding-left: var(--s7);
  }

  /* Fixed min-height so the numeric values and the shorter mono value sit on
     one optical line. */
  .stat-v {
    display: flex;
    align-items: flex-end;
    min-height: var(--fs-stat);
    font-size: var(--fs-stat);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--t1);
    font-variant-numeric: tabular-nums;
  }

  /* THE single data highlight on the page: the one non-numeric value, in mono,
     in the accent. One of the five sanctioned accent uses. */
  .stat-v--mark {
    font-family: var(--mono);
    font-size: var(--fs-h2);
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .stat-k {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    line-height: 1.45;
    color: var(--t3);
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats > div {
      padding: var(--s5) var(--s5) var(--s5) 0;
    }

    .stats > div:not(:first-child) {
      padding-left: 0;
      border-left: 0;
    }

    .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--hair);
    }

    .stats > div:nth-child(even) {
      border-left: 1px solid var(--hair);
      padding-left: var(--s5);
      padding-right: 0;
    }

    .stat-v {
      font-size: 1.875rem;
      min-height: 1.875rem;
    }

    .stat-v--mark {
      font-size: 1.25rem;
    }
  }
</style>
