---
// Writing: date on the spine, title and summary beside it. Drafts are visible
// in dev only, matching the blog index behaviour.
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

{
  posts.length > 0 && (
    <section class="sec" id="writing">
      <div class="shell">
        <header class="sec-head">
          <span class="sec-num">05</span>
          <h2>Writing</h2>
          <span class="sec-meta">
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </span>
        </header>

        <div class="sec-body">
          <ol class="posts">
            {posts.map((p) => (
              <li>
                <a class="post" href={`/blog/${p.id}`}>
                  <time datetime={iso(p.data.date)}>{iso(p.data.date)}</time>
                  <div>
                    <h3>{p.data.title}</h3>
                    <p>{p.data.summary}</p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style>
  .posts {
    border-bottom: 1px solid var(--hair);
  }

  .posts > li {
    border-top: 1px solid var(--hair);
  }

  /* The section head rule already closes the top edge. */
  .posts > li:first-child {
    border-top: 0;
  }

  .post {
    display: grid;
    grid-template-columns: var(--spine) minmax(0, 1fr);
    column-gap: var(--gutter);
    padding: var(--s6) 0;
    align-items: baseline;
  }

  .post time {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
    color: var(--t3);
  }

  .post h3 {
    font-size: var(--fs-lede);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--t1);
    line-height: var(--lh-heading);
    transition: color var(--t-fast) ease;
  }

  .post p {
    font-size: var(--fs-sm);
    color: var(--t2);
    margin-top: 0.375rem;
    max-width: 62ch;
  }

  @media (hover: hover) and (pointer: fine) {
    .post:hover h3 {
      color: #fff;
    }
  }

  @media (max-width: 800px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s2);
    }
  }
</style>
