---
// Hero: asymmetric two-column. Copy and actions on the wide side, a flat
// hairline-ruled index card of facts on the narrow one. The card is
// deliberately NOT raised, so the raised treatment stays reserved for things
// you can act on.
import { profile, heroFacts } from '../data/profile';
import CopyEmailButton from './CopyEmailButton.astro';
---

<section class="hero" id="top" aria-label="Introduction">
  <div class="shell hero-in">
    <div>
      <p class="hero-id">
        <b>{profile.name}</b>
        <em>{profile.title}</em>
      </p>

      <h1>I ship production software. Then I make it intelligent.</h1>

      <p class="lede">
        9 years building web applications and backend systems in Python, Django,
        FastAPI, TypeScript and React. Recent focus: LLM integration and RAG
        pipelines in production.
      </p>

      <div class="hero-actions">
        <CopyEmailButton id="copy-email-hero" />
        <a class="btn" href={profile.cv.href} download={profile.cv.downloadName}>
          Download CV
        </a>
      </div>
    </div>

    <dl class="index-card">
      {
        heroFacts.map((f) => (
          <div>
            <dt>{f.key}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: var(--s20) 0 var(--s14);
  }

  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: var(--s14);
    align-items: start;
  }

  .hero-id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.01em;
    margin-bottom: var(--s7);
  }

  .hero-id b {
    font-weight: 500;
    color: var(--t1);
  }

  .hero-id em {
    font-style: normal;
    color: var(--t3);
  }

  h1 {
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: -0.028em;
    font-weight: 500;
    max-width: 22ch;
    color: var(--t1);
    text-wrap: balance;
  }

  .lede {
    margin-top: var(--s6);
    font-size: var(--fs-lede);
    line-height: 1.62;
    color: var(--t2);
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s10);
  }

  .index-card {
    padding-top: var(--s2);
  }

  .index-card > div {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: var(--s4);
    padding: var(--s3) 0;
    border-top: 1px solid var(--hair);
    font-family: var(--mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
  }

  .index-card dt {
    color: var(--t3);
  }

  .index-card dd {
    color: var(--t1);
  }

  @media (max-width: 900px) {
    .hero {
      padding: var(--s12) 0 var(--s10);
    }

    .hero-in {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s10);
    }
  }
</style>
