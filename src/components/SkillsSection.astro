---
// Capabilities. The AI/LLM group gets the page's only raised panel and its only
// drawn figure, because it is the lead differentiator. Every other group is a
// flat row on the spine. That contrast is what makes the emphasis read without
// spending any extra colour.
import { aiGroup, skillGroups } from '../data/skills';

const groupCount = skillGroups.length + 1;
---

<section class="sec" id="skills">
  <div class="shell">
    <header class="sec-head">
      <span class="sec-num">02</span>
      <h2>Capabilities</h2>
      <span class="sec-meta">{groupCount} groups</span>
    </header>

    <div class="sec-body">
      <div class="ai">
        <p class="ai-top">
          <b>{aiGroup.label}</b>
          <em>{aiGroup.status}</em>
        </p>

        <h3>{aiGroup.headline}</h3>
        <p>{aiGroup.blurb}</p>

        <figure class="pipe">
          <div class="scroller">
            <ol class="pipe-rail">
              {
                aiGroup.pipeline.map((step, i) => (
                  <li>
                    <span class="pipe-i">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pipe-l">{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <figcaption>{aiGroup.pipelineCaption}</figcaption>
        </figure>

        <ul class="tags" aria-label="AI and LLM stack">
          {aiGroup.items.map((item) => <li class="is-ai">{item}</li>)}
        </ul>
      </div>

      <dl class="skills">
        {
          skillGroups.map((g) => (
            <div>
              <dt>
                {g.name}
                {g.note && <small>{g.note}</small>}
              </dt>
              <dd>
                <ul class="tags">
                  {g.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .ai {
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    background: var(--n800);
    box-shadow: var(--lift), var(--depth);
    padding: var(--s7);
  }

  .ai-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.01em;
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--hair);
  }

  .ai-top b {
    color: var(--accent);
    font-weight: 500;
  }

  .ai-top em {
    font-style: normal;
    color: var(--t3);
  }

  .ai h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-top: var(--s6);
    max-width: 46ch;
  }

  .ai > p {
    color: var(--t2);
    margin-top: var(--s3);
    max-width: 62ch;
  }

  .ai .tags {
    margin-top: var(--s6);
  }

  /* The retrieval path: a rule and five nodes. No icons, no imagery. */
  .pipe {
    margin-top: var(--s8);
  }

  .pipe-rail {
    display: flex;
    min-width: 33rem;
    padding-bottom: var(--s2);
  }

  .pipe-rail li {
    flex: 1 1 0;
    min-width: 6.25rem;
    position: relative;
    padding: var(--s4) var(--s4) 0 0;
    border-top: 1px solid var(--hair-2);
  }

  .pipe-rail li::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--n700);
    box-shadow: 0 0 0 1px var(--hair-2);
  }

  /* The last node closes the rail, so it gets a terminating dot and no trailing
     flex growth. */
  .pipe-rail li:last-child {
    flex: 0 0 auto;
    min-width: 4.75rem;
    padding-right: 0;
  }

  .pipe-rail li:last-child::after {
    content: '';
    position: absolute;
    top: -3px;
    right: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--n700);
    box-shadow: 0 0 0 1px var(--hair-2);
  }

  .pipe-i {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    font-variant-numeric: tabular-nums;
    color: var(--t3);
    letter-spacing: 0.05em;
    margin-bottom: var(--s1);
  }

  .pipe-l {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t1);
  }

  .pipe figcaption {
    font-size: var(--fs-sm);
    color: var(--t3);
    margin-top: var(--s5);
    max-width: 62ch;
  }

  .skills {
    margin-top: var(--s10);
  }

  .skills > div {
    display: grid;
    grid-template-columns: var(--spine) minmax(0, 1fr);
    column-gap: var(--gutter);
    padding: var(--s5) 0;
    border-top: 1px solid var(--hair);
    align-items: start;
  }

  .skills dt {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t1);
  }

  .skills dt small {
    display: block;
    font-size: var(--fs-micro);
    color: var(--t3);
    margin-top: 0.375rem;
    letter-spacing: 0.01em;
  }

  @media (max-width: 800px) {
    .skills > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.875rem;
    }
  }

  @media (max-width: 560px) {
    .ai {
      padding: var(--s5);
    }
  }
</style>
