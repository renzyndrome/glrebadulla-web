---
// Skills. Featured llm-integration card leads (AI is the differentiator).
// Chip style here = green BORDER (distinct from projects' green-tint chips).
const languages = 'Python · TypeScript · JavaScript · SQL';

const featuredChips = [
  'OpenAI API',
  'embeddings + retrieval (RAG)',
  'LangChain',
  'Claude Code',
];

const cards = [
  {
    dir: 'backend/',
    comment: '# APIs that hold up under real load',
    tech: 'Django · DRF · FastAPI · Flask · Node.js · Celery · Redis · REST design',
  },
  {
    dir: 'frontend/',
    comment: '# typed React interfaces that load fast',
    tech: 'React · Next.js · TanStack (Start · Router · Query) · Vite',
  },
  {
    dir: 'cloud-devops/',
    comment: '# deployed, monitored and scaled',
    tech: 'AWS (EC2 · S3 · Lambda · RDS · API Gateway · CloudWatch) · Docker · Linux · CI/CD · Cloudflare Workers + R2',
  },
  {
    dir: 'databases/',
    comment: '# the right store for the job',
    tech: 'PostgreSQL · MySQL · MongoDB · Firebase · Supabase',
  },
];
---

<section class="skills pad-x" id="skills">
  <h2 class="cmd"><span class="prompt">$</span> ls skills/ --featured</h2>
  <p class="languages">languages: <span class="lang-values">{languages}</span></p>

  <div class="skills-grid">
    <article class="featured">
      <div class="featured-head">
        <h3 class="featured-dir">llm-integration/</h3>
        <span class="featured-comment"># the differentiator</span>
      </div>
      <p class="featured-p">
        RAG pipelines and OpenAI features that answer from your data instead of
        guessing. Already running in tools a content team uses every day.
      </p>
      <div class="chips">
        {featuredChips.map((c) => <span class="chip-border">{c}</span>)}
      </div>
    </article>

    {
      cards.map((card) => (
        <article class="card">
          <h3 class="card-dir">{card.dir}</h3>
          <p class="card-comment">{card.comment}</p>
          <p class="card-tech">{card.tech}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .skills {
    padding-top: 0;
    padding-bottom: 68px;
  }

  .cmd {
    margin-bottom: 10px;
  }

  .languages {
    margin: 0 0 18px;
    font: 400 12.5px var(--font);
    color: var(--text-secondary);
  }

  .lang-values {
    color: var(--text);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .featured {
    grid-column: 1 / -1;
    background: var(--bg-panel);
    border: 1px solid var(--accent-border);
    border-radius: var(--r-card);
    padding: 24px 26px;
  }

  .featured-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }

  .featured-dir {
    font: 600 15px var(--font);
    color: var(--accent);
  }

  .featured-comment {
    font: 400 11px var(--font);
    color: var(--text-muted);
  }

  .featured-p {
    margin: 0 0 14px;
    max-width: 780px;
    font: 400 13px/1.7 var(--font);
    color: var(--text-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip-border {
    font: 400 12px var(--font);
    padding: 6px 12px;
    border: 1px solid var(--accent-border-chip);
    border-radius: var(--r-chip);
    color: var(--accent-soft);
  }

  .card {
    background: var(--bg-panel);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    padding: 22px 24px;
  }

  .card-dir {
    margin: 0 0 6px;
    font: 600 14px var(--font);
    color: var(--text);
  }

  .card-comment {
    margin: 0 0 10px;
    font: 400 12.5px/1.65 var(--font);
    color: var(--text-secondary);
  }

  .card-tech {
    margin: 0;
    font: 400 12px/2 var(--font);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
