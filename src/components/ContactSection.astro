---
// Contact: actions and links on the wide side, the WhatsApp QR card on the
// narrow one. The QR is a real image (public/wa-qr.png) on a white plate, since
// a QR needs light ground and quiet zone to scan reliably.
//
// The QR is the ONLY way WhatsApp is exposed. The phone number is never rendered
// as text and the card is not a link, because a link would put the number in the
// href and in the browser status bar. This is a deliberate privacy choice by the
// owner: do not make the card clickable. Kept as a frontmatter comment rather
// than an HTML comment so it does not ship in the built page.
import { profile, links } from '../data/profile';
import CopyEmailButton from './CopyEmailButton.astro';
---

<section class="sec" id="contact">
  <div class="shell">
    <header class="sec-head">
      <span class="sec-num">06</span>
      <h2>Let's build something.</h2>
      <span class="sec-meta">{profile.status}</span>
    </header>

    <div class="sec-body contact">
      <div>
        <p>
          Available for senior full-stack and AI integration work. Email me, or
          scan the code to open a WhatsApp chat directly.
        </p>

        <div class="contact-actions">
          <CopyEmailButton id="copy-email-contact" />
          <a class="mailto" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>

        <nav class="elsewhere" aria-label="Elsewhere">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={profile.cv.href} download={profile.cv.downloadName}>
            latest-cv.pdf
          </a>
        </nav>
      </div>

      <figure class="wa">
        <span class="qr-plate">
          <img
            src="/wa-qr.png"
            alt="QR code that opens a WhatsApp chat with Laurence Rebadulla"
            width="128"
            height="128"
            decoding="async"
          />
        </span>
        <figcaption class="wa-label">Scan for WhatsApp</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 4rem;
    align-items: start;
  }

  .contact > div > p {
    color: var(--t2);
    max-width: 52ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s7);
  }

  /* The underline hugs the text via text-decoration rather than a border on the
     44px tap box, so it does not float away from the baseline. */
  .mailto {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    color: var(--t2);
    text-decoration: underline;
    text-decoration-color: var(--hair-2);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--t-fast) ease,
      text-decoration-color var(--t-fast) ease;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s7);
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--hair);
  }

  .elsewhere a {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--t3);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--t-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .mailto:hover {
      color: var(--t1);
      text-decoration-color: var(--t3);
    }

    .elsewhere a:hover {
      color: var(--t1);
    }
  }

  .wa {
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    background: var(--n800);
    box-shadow: var(--lift), var(--depth);
    padding: var(--s5);
    text-align: center;
    margin: 0;
  }

  /* A QR needs a light ground and a quiet zone to scan. */
  .qr-plate {
    display: block;
    padding: var(--s2);
    background: #fff;
    border-radius: var(--r-btn);
  }

  .qr-plate img {
    width: 128px;
    height: 128px;
  }

  /* A caption, not a link: no underline and no hover state, so it does not
     advertise an interaction that is not there. */
  .wa-label {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--t3);
    margin-top: 0.875rem;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s10);
    }

    .wa {
      justify-self: start;
    }
  }
</style>
