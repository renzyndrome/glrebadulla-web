---
// Sticky masthead: wordmark left, section links right. The underline is a child
// span scaled from the left edge rather than a border, so it can animate
// asymmetrically (slower in than out) without shifting layout.
import { profile } from '../data/profile';

// Root-relative so the links also work from /blog and /projects/*, where these
// section anchors do not exist on the page.
const sections = [
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Capabilities' },
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#writing', label: 'Writing' },
];
---

<header class="masthead">
  <div class="shell masthead-in">
    <a class="wordmark" href="/">
      {profile.name} <span>{profile.shortLocale}</span>
    </a>
    <nav class="nav" aria-label="Sections">
      <div class="nav-full">
        {
          sections.map((s) => (
            <a class="navlink" href={s.href}>
              {s.label}
              <span class="rule" aria-hidden="true" />
            </a>
          ))
        }
      </div>
      <a class="navlink" href="/#contact">
        Contact
        <span class="rule" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--n900);
    border-bottom: 1px solid var(--hair);
  }

  .masthead-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    min-height: 56px;
  }

  .wordmark {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    font-weight: 500;
    color: var(--t1);
    letter-spacing: 0.01em;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }

  .wordmark span {
    color: var(--t3);
    margin-left: var(--s2);
    font-variant-numeric: tabular-nums;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s6);
  }

  .navlink {
    position: relative;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.01em;
    color: var(--t2);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1px;
    white-space: nowrap;
    transition: color var(--t-fast) ease;
  }

  .navlink .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 0.8em);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-out) var(--ease-in);
  }

  .navlink:focus-visible .rule {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .navlink:hover {
      color: var(--t1);
    }

    .navlink:hover .rule {
      transform: scaleX(1);
      transition: transform var(--t-in) var(--ease-out);
    }
  }

  .nav-full {
    display: flex;
    gap: var(--s6);
  }

  /* Below 800px the five section links would crowd the wordmark. Contact is the
     one that matters on a phone, so it is the one that stays. */
  @media (max-width: 800px) {
    .nav-full {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navlink .rule {
      transform: scaleX(1);
      opacity: 0;
      transition: opacity var(--t-fast) ease;
    }

    .navlink:hover .rule,
    .navlink:focus-visible .rule {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
