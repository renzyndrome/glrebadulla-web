---
// Experience as real tabular data in a real table, because that is the
// structure a reader uses to cross-check a CV. The table keeps its semantics
// and scrolls on narrow screens rather than being reflowed to display:block,
// which would strip the row/column relationships from the a11y tree.
import { roles, education } from '../data/experience';

const firstYear = roles[roles.length - 1].period.slice(0, 4);
---

<section class="sec" id="experience">
  <div class="shell">
    <header class="sec-head">
      <span class="sec-num">04</span>
      <h2>Experience</h2>
      <span class="sec-meta">{firstYear} to present</span>
    </header>

    <div class="sec-body">
      <div class="scroller" role="region" aria-label="Experience table" tabindex="0">
        <table class="xp">
          <caption class="sr-only">
            Professional experience, most recent first
          </caption>
          <thead>
            <tr>
              <th scope="col">Period</th>
              <th scope="col">Role</th>
              <th scope="col">Organization</th>
              <th scope="col">Stack</th>
            </tr>
          </thead>
          <tbody>
            {
              roles.map((r) => (
                <tr>
                  <td><span class="xp-when">{r.period}</span></td>
                  <td>
                    <span class="xp-role">{r.role}</span>
                    <p class="xp-note">{r.note}</p>
                  </td>
                  <td>
                    <span class="xp-org">
                      {r.org}
                      {r.orgNote && <small>{r.orgNote}</small>}
                    </span>
                  </td>
                  <td><span class="xp-stack">{r.stack}</span></td>
                </tr>
              ))
            }
            <tr class="xp-edu">
              <td><span class="xp-when">{education.period}</span></td>
              <td><span class="xp-role">{education.qualification}</span></td>
              <td><span class="xp-org">{education.institution}</span></td>
              <td><span class="xp-stack">Education</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="scroll-hint">Scroll the table for organization and stack &#8594;</p>
    </div>
  </div>
</section>

<style>
  .xp {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  .xp th {
    text-align: left;
    font-weight: 400;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--t3);
    padding: 0 var(--s6) 0.875rem 0;
  }

  .xp td {
    padding: var(--s5) var(--s6) var(--s5) 0;
    border-top: 1px solid var(--hair);
    vertical-align: top;
  }

  /* The Period column sits on the spine, like every other leading column. */
  .xp th:first-child,
  .xp td:first-child {
    width: 10rem;
    padding-right: var(--gutter);
  }

  .xp-when {
    font-family: var(--mono);
    font-size: var(--fs-mono-l);
    font-variant-numeric: tabular-nums;
    color: var(--t2);
    white-space: nowrap;
  }

  /* The current role reads brighter, not accented: the accent budget is spent
     elsewhere and brightness is enough to mark one row. */
  .xp tbody tr:first-child .xp-when {
    color: var(--t1);
  }

  .xp-role {
    display: block;
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--t1);
  }

  .xp-note {
    font-size: var(--fs-sm);
    color: var(--t3);
    margin-top: 0.375rem;
    max-width: 44ch;
  }

  .xp-org {
    display: block;
    font-size: var(--fs-body);
    color: var(--t2);
  }

  .xp-org small {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    color: var(--t3);
    margin-top: var(--s1);
  }

  .xp-stack {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--t3);
    line-height: 1.55;
  }

  /* Education is a different kind of row, so it reads one step quieter. */
  .xp-edu .xp-role {
    font-weight: 400;
    color: var(--t2);
  }

  .scroll-hint {
    display: none;
  }

  @media (max-width: 800px) {
    .scroll-hint {
      display: block;
      font-family: var(--mono);
      font-size: var(--fs-micro);
      color: var(--t3);
      margin-top: 0.875rem;
    }
  }
</style>
