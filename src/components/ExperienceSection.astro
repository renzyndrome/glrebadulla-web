---
// Experience — git-log metaphor. Only the current role's date (2024 — present)
// is green. Em-dashes in the date ranges are fixed design strings (keep them).
interface Role {
  date: string;
  title: string;
  summary: string;
  current?: boolean;
}

const roles: Role[] = [
  {
    date: '2024 — present',
    current: true,
    title: 'Senior Full Stack Developer · US-based Media Company (remote)',
    summary:
      'LLM features via OpenAI API, retrieval pipelines, real-time analytics, social automation. Python, FastAPI, React, AWS.',
  },
  {
    date: '2023 — 2024',
    title: 'Senior Full Stack Developer · Connect Psych Services (remote)',
    summary:
      'Telehealth platform with live chat, voice and video. Django REST, React, Next.js on AWS.',
  },
  {
    date: '2020 — 2023',
    title: 'Software Developer → Senior · LITS',
    summary:
      'Led E-Legislative System for local government; Odoo CRM/Website/HRIS. Promoted for technical leadership.',
  },
  {
    date: '2018 — 2019',
    title: 'Junior Software Engineer · Infoshift Inc.',
    summary:
      'Public developer APIs for one of the largest PH telecoms. Flask, Node.js, AWS microservices.',
  },
];
---

<section class="experience pad-x" id="experience">
  <h2 class="cmd"><span class="prompt">$</span> git log --oneline --experience</h2>
  <ol class="log">
    {
      roles.map((r) => (
        <li class="row">
          <div class:list={['date', { 'date--current': r.current }]}>
            {r.date}
          </div>
          <div class="detail">
            <h3 class="role-title">{r.title}</h3>
            <div class="role-summary">{r.summary}</div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience {
    padding-top: 0;
    padding-bottom: 68px;
  }

  .cmd {
    margin-bottom: 26px;
  }

  .log {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 32px;
    padding: 22px 0;
    border-top: 1px solid var(--hairline);
  }

  .row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .date {
    font: 400 12.5px var(--font);
    color: var(--text-muted);
  }

  .date--current {
    color: var(--accent);
  }

  .role-title {
    font: 600 15px var(--font);
    color: var(--text);
  }

  .role-summary {
    margin-top: 6px;
    font: 400 13px/1.7 var(--font);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
