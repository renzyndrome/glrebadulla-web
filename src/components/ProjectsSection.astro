---
// Selected work: dense rows, not a card wall. Each row is one link covering the
// whole area, so the hit target is the row rather than the title alone.
//
// Hairlines live on the <li> and the hover surface lives on the <a>, which
// bleeds 1rem past them on purpose: the rules stay aligned with every other
// rule on the page while the hover state reads as a wider band.
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="sec" id="work">
  <div class="shell">
    <header class="sec-head">
      <span class="sec-num">03</span>
      <h2>Work</h2>
      <span class="sec-meta">{projects.length} projects</span>
    </header>

    <div class="sec-body">
      <ol class="rows">
        {
          projects.map((p, i) => (
            <li>
              <a class="row" href={`/projects/${p.id}`}>
                <span class="row-i">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="row-name">{p.data.name ?? p.id}</h3>
                  <p class="row-d">{p.data.description}</p>
                </div>
                <div class="row-tags">
                  <ul class="tags">
                    {p.data.chips.map((c) => (
                      <li class:list={[{ 'is-ai': c.ai }]}>{c.label}</li>
                    ))}
                  </ul>
                </div>
                <span class="row-go" aria-hidden="true">&#8594;</span>
              </a>
            </li>
          ))
        }
      </ol>

      <p class="nda">
        Most of this is internal tooling built for employers under NDA. The
        descriptions are the part I can share. Screenshots, client names and
        production data are not.
      </p>
    </div>
  </div>
</section>

<style>
  .rows {
    border-bottom: 1px solid var(--hair);
  }

  .rows > li {
    border-top: 1px solid var(--hair);
    transition: border-color 180ms var(--ease-in);
  }

  /* The section head rule already closes the top edge: never double a hairline. */
  .rows > li:first-child {
    border-top: 0;
  }

  .row {
    display: grid;
    grid-template-columns: var(--spine) minmax(0, 1fr) minmax(0, 13rem) 1.5rem;
    column-gap: var(--gutter);
    align-items: start;
    margin: 0 calc(var(--s4) * -1);
    padding: 1.375rem var(--s4);
    border-radius: var(--r-btn);
    transition: background-color 180ms var(--ease-in);
  }

  .row-i {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
    color: var(--t3);
    padding-top: 0.1875rem;
  }

  .row-name {
    font-family: var(--mono);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--t1);
    letter-spacing: -0.005em;
    line-height: 1.4;
  }

  .row-d {
    font-size: var(--fs-sm);
    color: var(--t2);
    margin-top: 0.375rem;
    max-width: 52ch;
  }

  .row-tags {
    padding-top: 0.1875rem;
  }

  .row-go {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--accent);
    justify-self: end;
    padding-top: var(--s1);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 160ms var(--ease-in), transform 160ms var(--ease-in);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      background: var(--n750);
    }

    .rows > li:has(.row:hover) {
      border-top-color: var(--hair-2);
    }

    .row:hover .row-go {
      opacity: 1;
      transform: translateX(0);
      transition: opacity var(--t-in) var(--ease-out),
        transform var(--t-in) var(--ease-out);
    }
  }

  /* Keyboard users get the same affordance as pointer users. */
  .row:focus-visible {
    background: var(--n750);
    outline-offset: 3px;
  }

  .row:focus-visible .row-go {
    opacity: 1;
    transform: translateX(0);
    transition: opacity var(--t-in) var(--ease-out),
      transform var(--t-in) var(--ease-out);
  }

  .nda {
    font-size: var(--fs-sm);
    color: var(--t3);
    margin-top: var(--s6);
    max-width: 62ch;
  }

  @media (max-width: 960px) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      column-gap: var(--s5);
      row-gap: var(--s3);
    }

    .row-tags {
      grid-column: 2;
      grid-row: 2;
    }

    .row-go {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-go,
    .row:hover .row-go,
    .row:focus-visible .row-go {
      transform: none;
      transition: opacity var(--t-fast) ease;
    }
  }
</style>
