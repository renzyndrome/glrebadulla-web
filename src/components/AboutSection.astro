---
// About. To swap in the real photo: drop a file into public/images/ and pass
// its path as `imageSrc` (e.g. <AboutSection imageSrc="/images/laurence.jpg" />).
interface Props {
  imageSrc?: string;
}
const { imageSrc } = Astro.props;

const links = [
  { href: 'https://glrebadulla.dev', label: 'glrebadulla.dev ↗' },
  { href: 'https://github.com/renzyndrome', label: 'github.com/renzyndrome ↗' },
  {
    href: 'https://linkedin.com/in/laurencerebadulla',
    label: 'linkedin/laurencerebadulla ↗',
  },
];
---

<section class="about pad-x" id="about">
  <div class="about-grid">
    <div class="photo">
      {
        imageSrc ? (
          <img
            src={imageSrc}
            alt="Laurence Rebadulla"
            width="260"
            height="300"
            loading="lazy"
          />
        ) : (
          <div class="hatch photo-ph">
            <span>[ your photo ]</span>
          </div>
        )
      }
    </div>

    <div class="bio">
      <p class="cmd"><span class="prompt">$</span> cat about.md</p>
      <h2 class="about-h2">End-to-end ownership,<br />minimal supervision.</h2>
      <p class="about-p">
        I build features end to end: database design, APIs, frontend, and
        deployment on AWS. I've shipped products in media, telehealth,
        government and telecom. These days I add LLM features through the OpenAI
        API and retrieval pipelines with embeddings and LangChain, so products
        answer from their own data instead of generic model output.
      </p>
      <div class="about-links">
        {
          links.map((l) => (
            <a href={l.href} class="ext" target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 68px;
    padding-bottom: 68px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    align-items: start;
  }

  .photo,
  .photo-ph,
  .photo img {
    width: 260px;
    height: 300px;
    border-radius: var(--r-card);
  }

  .photo-ph {
    border: 1px solid var(--hairline-frame);
  }

  .photo img {
    object-fit: cover;
    border: 1px solid var(--hairline-frame);
  }

  .cmd {
    margin-bottom: 16px;
  }

  .about-h2 {
    margin: 0 0 18px;
    font: 600 26px/1.3 var(--font);
    letter-spacing: -0.02em;
  }

  .about-p {
    margin: 0;
    max-width: 660px;
    font: 400 14px/1.8 var(--font);
    color: var(--text-secondary);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 22px;
    font: 400 12.5px var(--font);
  }

  .ext {
    color: var(--text);
    transition: color var(--hover);
  }

  .ext:hover {
    color: var(--text);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* ≤640px (mobile): ≥44px tap targets for the external link row. */
  @media (max-width: 640px) {
    .ext {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
