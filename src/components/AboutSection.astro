---
// About: prose on the spine's content column, portrait in the right column.
//
// The portrait goes through astro:assets rather than sitting in public/, so the
// build emits a resized, compressed WebP instead of shipping the full-size JPEG
// untouched. Width is set to 576 (2x the 18rem display box) and the height is
// left for Astro to infer, which keeps the source's own aspect ratio on the
// <img> and lets the CSS crop it to 4:5 with object-fit.
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/laurence-rebadulla.jpg';
---

<section class="sec" id="about">
  <div class="shell">
    <header class="sec-head">
      <span class="sec-num">01</span>
      <h2>End-to-end ownership, minimal supervision.</h2>
      <span class="sec-meta">{profile.location} · {profile.timezone}</span>
    </header>

    <div class="sec-body about">
      <figure class="photo">
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          width={640}
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about-body">
        <p>
          I build features end to end: database design, APIs, frontend, and
          deployment on AWS. I've shipped products in media, telehealth,
          government and telecom, and I've worked remotely with international
          teams since 2023.
        </p>
        <p>
          These days I add LLM features through the OpenAI API and retrieval
          pipelines with embeddings and LangChain, so products <strong>answer
          from their own data</strong> instead of generic model output.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Column 1 is the empty spine, so the portrait's left edge lands exactly
     where the h2 above it starts. Photo left, prose right, both top-aligned. */
  .about {
    display: grid;
    grid-template-columns: var(--spine) auto minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: start;
  }

  .photo {
    grid-column: 2;
    width: 20rem;
    /* Square, for proportion. The bio is two short paragraphs, so a tall
       portrait frame left a dead quadrant under the text. A square is shorter
       and wider at the same area, and since the source is a landscape headshot
       cover only trims about 10% off each side, which also makes the face read
       larger in frame. Change this one width to resize the photo. */
    aspect-ratio: 1 / 1;
    border: 1px solid var(--hair);
    border-radius: var(--r-card);
    background: var(--n850);
    overflow: hidden;
    margin: 0;
  }

  .about-body {
    grid-column: 3;
  }

  /* Fills the well edge to edge; overflow clips it to the radius. */
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .about-body p {
    color: var(--t2);
    max-width: 62ch;
  }

  .about-body p + p {
    margin-top: var(--s4);
  }

  .about-body strong {
    color: var(--t1);
    font-weight: 500;
  }

  /* One column below 900px. The portrait leads because it comes first in the
     markup, which is also the reading order it should have. */
  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s6);
    }

    .photo,
    .about-body {
      grid-column: 1;
    }

    .photo {
      width: 14rem;
    }
  }
</style>
